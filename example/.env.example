# Copy to example/.env, or export these instead -- an exported variable wins.
# The parser is strict: KEY=value, no quoting, no expansion, no `export`.

# The database. No default: connecting to the wrong one silently is worse than
# not starting. The schema walkthrough has the container command.
CAMERA_TRAP_DSN=postgresql://wreath:wreath@127.0.0.1:55432/wreath_test

# The widest span of sightings one request may ask for. A caller asking for
# more gets a 422 from the binding layer, before any SQL is built.
CAMERA_TRAP_MAX_WINDOW_DAYS=90

# Seconds the cached species list may be stale. A write to the species table
# clears it immediately regardless; this is the backstop for a change wreath
# cannot see, such as a row edited by hand in psql.
CAMERA_TRAP_SPECIES_CACHE_TTL=300
