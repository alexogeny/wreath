# wreath — environment variables
#
# Copy to `.env` for local use. `.env` is gitignored; this file is committed
# as documentation. Every var here is optional; the defaults are shown.

# =============================================================================
# Server configuration — bound by ServerConfig.from_env()
# =============================================================================
# The single source of truth for these names is `_SERVER_ENV_REGISTRY` in
# src/wreath/server.py. Precedence is: dataclass default < environment < explicit
# code argument. `wreath.server.run(app)` (with no `config=`) reads them; or call
# `ServerConfig.from_env()` yourself. An unset or empty value keeps the default.

# WREATH_HOST=127.0.0.1
# WREATH_PORT=8000
# WREATH_BACKLOG=2048
# WREATH_KEEP_ALIVE_TIMEOUT=5.0
# WREATH_REQUEST_TIMEOUT=30.0
# WREATH_SHUTDOWN_TIMEOUT=10.0
# WREATH_SERVER_HEADER=wreath
# WREATH_DATE_HEADER=true          # true/false/1/0/yes/no/on/off
# WREATH_MAX_REQUEST_LINE=8192
# WREATH_MAX_HEADER_COUNT=100
# WREATH_MAX_HEADER_BYTES=32768
# WREATH_MAX_BODY_BYTES=1048576
# WREATH_MAX_BODY_CHUNKS=4096
# WREATH_LIFESPAN=auto             # auto | on | off
# WREATH_PROTOCOLS=http/1.1        # comma-separated: http/1.1,h2,h3

# =============================================================================
# Framework toggles (not part of ServerConfig)
# =============================================================================
# --- Runtime ---
# Force the pure-Python implementation, skipping the compiled native
# extensions. Any non-empty value enables it.
# WREATH_PURE=1

# --- Build-time (read by setup.py during `pip install` / `uv sync`) ---
# Build the optional HTTP/3 extension. Must be exactly "1" to enable. Requires
# the from-source nghttp3/ngtcp2 toolchain (see benchmarks/README.md).
# WREATH_BUILD_HTTP3=0
# Produce a profiling build of the native extensions. Must be exactly "1".
# WREATH_NATIVE_PROFILE=0

# =============================================================================
# Application keys you declare as boot-critical
# =============================================================================
# wreath does not bind these to any field — your app reads them (via
# wreath.config.load_env or os.environ) and uses the values itself. Pass their
# names to `run(app, required_env=[...])` (or `configure_from_env(required=...)`)
# and any that are unset emit an EnvConfigWarning at boot instead of failing
# deep in a request. The entries below are examples; rename to match your app.

# DATABASE_URL=postgres://user:password@localhost:5432/app
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# SECRET_KEY=change-me
