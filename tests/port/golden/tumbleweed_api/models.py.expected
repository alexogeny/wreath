class Booking(Model, AuditMixin, table="booking"):
    

    id: Mapped[uuid.UUID] = column(Uuid, primary_key=True, default=generate_guid)
    ranch_id: Mapped[uuid.UUID] = column(Uuid, references=Ranch.id, index=True)
    ranch = relationship(Ranch, load="raise")
    llama_id: Mapped[uuid.UUID] = column(Uuid, references=Llama.id, index=True)
    llama = relationship(Llama, load="raise")
    # TODO(wreath-port: [translated] this column set choices=, which wreath's column() has no setting for. Decide what each one should become before relying on this model [orm.column])
    status: Mapped[str] = column(Varchar, default=TrekStatus.DRAFT.value, check=Length(maximum=20))
    guests: Mapped[int] = column(Int64, check=Ge(1))
    notes: Mapped[str] = column(Text, nullable=True)


# TODO(wreath-port: [translated] check whether these columns should allow NULL. ormar let a column be empty unless told otherwise; wreath requires a value unless told otherwise, so the ones that said nothing have just changed meaning: name, cents_per_day [orm.column])
