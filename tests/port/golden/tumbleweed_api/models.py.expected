"""Ormar models — the herd, ranches, bookings, and pricing.

Exercises: tablename via ``.copy(tablename=)``, a mixin, ForeignKey, an enum,
a JSONB column, a Postgres array column, nullable columns, ``server_default``,
and a UUID primary key with ``default_factory``.
"""
import enum
import uuid

import ormar
import sqlalchemy
from ormar_postgres_extensions.fields import ARRAY

from tumbleweed_core import base_ormar_config, generate_guid
from wreath.orm import Ge, Length, Mapped, Model, column, relationship
from wreath.orm.types import Array, Int64, Jsonb, Text, Uuid, Varchar


class AuditMixin:
    created_at = ormar.DateTime(timezone=True, server_default=sqlalchemy.func.now())
    updated_at = ormar.DateTime(timezone=True, nullable=True)


class TrekStatus(str, enum.Enum):
    DRAFT = "draft"
    BOOKED = "booked"
    UNDERWAY = "underway"
    COMPLETE = "complete"


# TODO(wreath-port: [translated] check whether these columns should allow NULL. ormar let a column be empty unless told otherwise; wreath requires a value unless told otherwise, so the ones that said nothing have just changed meaning: name, slug [orm.column])
# TODO(wreath-port: [translated] this model inherits columns from a mixin. Move the mixin's columns over too, or the ported model will be missing them [orm.model])
class Ranch(Model, AuditMixin, table="ranch"):
    

    id: Mapped[uuid.UUID] = column(Uuid, primary_key=True, default=generate_guid)
    name: Mapped[str] = column(Varchar, check=Length(maximum=200))
    slug: Mapped[str] = column(Varchar, unique=True, check=Length(maximum=80))
    settings: Mapped[dict] = column(Jsonb, nullable=True)


# TODO(wreath-port: [translated] check whether these columns should allow NULL. ormar let a column be empty unless told otherwise; wreath requires a value unless told otherwise, so the ones that said nothing have just changed meaning: name, pack_weight_kg, tags [orm.column])
# TODO(wreath-port: [translated] this model inherits columns from a mixin. Move the mixin's columns over too, or the ported model will be missing them [orm.model])
class Llama(Model, AuditMixin, table="llama"):
    

    id: Mapped[uuid.UUID] = column(Uuid, primary_key=True, default=generate_guid)
    ranch_id: Mapped[uuid.UUID] = column(Uuid, references=Ranch.id, index=True)
    ranch = relationship(Ranch, load="raise")
    name: Mapped[str] = column(Varchar, check=Length(maximum=120))
    temperament: Mapped[str] = column(Varchar, nullable=True, check=Length(maximum=40))
    pack_weight_kg: Mapped[int] = column(Int64, server_default="0", check=Ge(0))
    tags: Mapped[list] = column(Array(Text))
    pack_manifest: Mapped[dict] = column(Jsonb, nullable=True)


