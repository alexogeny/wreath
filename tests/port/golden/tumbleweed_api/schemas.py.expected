from typing import Optional

from pydantic import ConfigDict, field_validator, model_validator
from dataclasses import dataclass, field


@dataclass
class BookingCreate:
    # wreath-port: extra='forbid' is wreath's default (dropped)

    llama_id: str
    # TODO(wreath-port: [needs-review] Field(ge=/le=) on a DTO has no dataclass slot — wreath's `Body`/`Form` markers carry only `alias`, so the constraint has three possible homes and they do not behave alike: `column(..., check=Ge(...))` if this DTO mirrors a table (guards the API and the database, one definition), `Annotated[int, Query(minimum=, maximum=)]` if the value is really a scalar parameter, or a handler guard raising UnprocessableEntity. Only the first two keep it a 422 at the boundary [pydantic.field_constraint])
    guests: int = Field(ge=1, le=12)
    notes: Optional[str] = None
    add_ons: list = field(default_factory=list)

    # TODO(wreath-port: [needs-review] field_validator/model_validator -> narrow()/@rule() with custom logic (manual) [pydantic.validator])
    @field_validator("notes")
    @classmethod
    def strip_notes(cls, value):
        return value.strip() if value else value


@dataclass
class RangeQuery:
    # wreath-port: extra='forbid' is wreath's default (dropped)

    start: int
    end: int

    # TODO(wreath-port: [needs-review] field_validator/model_validator -> narrow()/@rule() with custom logic (manual) [pydantic.validator])
    @model_validator(mode="after")
    def check_range(self):
        if self.end < self.start:
            raise ValueError("end before start")
        return self


@dataclass
class LlamaOut:
    id: str
    name: str
    temperament: Optional[str] = None
    tags: list = field(default_factory=list)
