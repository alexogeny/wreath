from typing import Optional

from pydantic import ConfigDict, model_validator
from wreath.binding import Field
from typing import Annotated
from dataclasses import dataclass, field


@dataclass
class BookingCreate:
    # wreath-port: extra='forbid' is wreath's default (dropped)

    llama_id: str
    guests: Annotated[int, Field(ge=1, le=12)]
    notes: Optional[str] = None
    add_ons: list = field(default_factory=list)

    def strip_notes(cls, value):
        return value.strip() if value else value

    def __post_init__(self) -> None:
        self.notes = self.strip_notes(self.notes)


@dataclass
class RangeQuery:
    # wreath-port: extra='forbid' is wreath's default (dropped)

    start: int
    end: int

    # TODO(wreath-port: [needs-review] A validator is code, so it has to be moved by hand. For a rule about one field, use narrow() on the column; for a rule spanning fields, use @rule(). Both run once when the app starts rather than on every request. [pydantic.validator])
    @model_validator(mode="after")
    def check_range(self):
        if self.end < self.start:
            raise ValueError("end before start")
        return self


@dataclass
class LlamaOut:
    id: str
    name: str
    temperament: Optional[str] = None
    tags: list = field(default_factory=list)
