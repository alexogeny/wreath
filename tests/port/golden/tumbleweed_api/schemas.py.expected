from typing import Optional

from pydantic import ConfigDict, Field, field_validator, model_validator
from dataclasses import dataclass, field


@dataclass
class BookingCreate:
    # wreath-port: extra='forbid' is wreath's default (dropped)

    llama_id: str
    # TODO(wreath-port: [needs-review] This field has a limit on its value, and wreath keeps limits where they can be enforced rather than on the model. Three places to choose from: put it on the database column as column(..., check=Ge(1)) if this model mirrors a table, which guards the API and the database at once; write it as Annotated[int, Query(minimum=1, maximum=100)] if the value really arrives as a query parameter; or check it in the handler and raise UnprocessableEntity. Only the first two still answer 422 automatically. [pydantic.field_constraint])
    guests: int = Field(ge=1, le=12)
    notes: Optional[str] = None
    add_ons: list = field(default_factory=list)

    # TODO(wreath-port: [needs-review] A validator is code, so it has to be moved by hand. For a rule about one field, use narrow() on the column; for a rule spanning fields, use @rule(). Both run once when the app starts rather than on every request. [pydantic.validator])
    @field_validator("notes")
    @classmethod
    def strip_notes(cls, value):
        return value.strip() if value else value


@dataclass
class RangeQuery:
    # wreath-port: extra='forbid' is wreath's default (dropped)

    start: int
    end: int

    # TODO(wreath-port: [needs-review] A validator is code, so it has to be moved by hand. For a rule about one field, use narrow() on the column; for a rule spanning fields, use @rule(). Both run once when the app starts rather than on every request. [pydantic.validator])
    @model_validator(mode="after")
    def check_range(self):
        if self.end < self.start:
            raise ValueError("end before start")
        return self


@dataclass
class LlamaOut:
    id: str
    name: str
    temperament: Optional[str] = None
    tags: list = field(default_factory=list)
