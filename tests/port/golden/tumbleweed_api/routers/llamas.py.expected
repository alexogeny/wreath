"""Llamas router.

Exercises: ``Query(20, ge=1, le=100, alias=...)``, Header/Cookie/Form/File
markers, an ``UploadFile``, ``include_in_schema=False``, a path ``int`` param,
``Model.get_pydantic(include=...)`` metaprogramming, and JSONB ``jsonb_has_any``
/ ``jsonb_contains`` query lookups.
"""
from typing import Optional

from wreath import Request, Router
from wreath.binding import Cookie, File, Form, Header, Query
from fastapi import UploadFile

from ..models import Llama
from ..schemas import LlamaOut
from ..storage import store_manifest
from typing import Annotated

router = Router(prefix="/llamas", tags=["llamas"])

# TODO(wreath-port: [unsupported] Model.get_pydantic() metaprogramming -> a hand-written DTO / column subset [pydantic.get_pydantic])
LlamaSummary = Llama.get_pydantic(include={"id", "name", "temperament"})


# TODO(wreath-port: [needs-review] include_in_schema=False -> exclude from app.enable_docs() surface [route.include_in_schema])
@router.get("", include_in_schema=False)
async def list_llamas(
    request: Request,
    limit: Annotated[int, Query(minimum=1, maximum=100, alias="pageSize")] = 20,
    temperament: Annotated[Optional[str], Query()] = None,
    # TODO(wreath-port: [translated] Query(default, ge=, le=) -> Annotated[T, Query(minimum=, maximum=)] = default (required marker: move to Annotated and order before defaulted params by hand) [param.query])
    x_ranch: str = Header(...),
    session_id: Annotated[Optional[str], Cookie()] = None,
):
    # TODO(wreath-port: [needs-review] filter(**kw) -> Model.select().where(Model.col == value); run it with session.fetch() for a list. This one needs a decision: a `__icontains`/`__startswith` lookup rewrites the *value* (wrap it in wildcards for .ilike()), a `__isnull` has no negated form, a relation lookup (`owner__name`) is `Model.owner.name` — wreath plans that INNER JOIN itself, but resolving `owner` to its target model is cross-module and this tool works one module at a time — and a jsonb lookup needs the container operator by hand [orm.query.filter])
    query = Llama.objects.filter(ranch__slug=x_ranch)
    if temperament:
        query = query.filter(temperament=temperament)
    return await query.limit(limit).all()


@router.get("/search")
async def search_by_tags(request: Request, tags: str):
    wanted = tags.split(",")
    # TODO(wreath-port: [needs-review] filter(**kw) -> Model.select().where(Model.col == value); run it with session.fetch() for a list. This one needs a decision: a `__icontains`/`__startswith` lookup rewrites the *value* (wrap it in wildcards for .ilike()), a `__isnull` has no negated form, a relation lookup (`owner__name`) is `Model.owner.name` — wreath plans that INNER JOIN itself, but resolving `owner` to its target model is cross-module and this tool works one module at a time — and a jsonb lookup needs the container operator by hand [orm.query.filter])
    return await Llama.objects.filter(tags__jsonb_has_any=wanted).all()


@router.get("/manifest-holders")
async def manifest_holders(request: Request, needle: dict):
    # TODO(wreath-port: [needs-review] filter(**kw) -> Model.select().where(Model.col == value); run it with session.fetch() for a list. This one needs a decision: a `__icontains`/`__startswith` lookup rewrites the *value* (wrap it in wildcards for .ilike()), a `__isnull` has no negated form, a relation lookup (`owner__name`) is `Model.owner.name` — wreath plans that INNER JOIN itself, but resolving `owner` to its target model is cross-module and this tool works one module at a time — and a jsonb lookup needs the container operator by hand [orm.query.filter])
    return await Llama.objects.filter(pack_manifest__jsonb_contains=needle).all()


@router.post("/{llama_id}/manifest")
async def upload_manifest(
    # TODO(wreath-port: [translated] Query(default, ge=, le=) -> Annotated[T, Query(minimum=, maximum=)] = default (required marker: move to Annotated and order before defaulted params by hand) [param.query])
    request: Request, llama_id: str, note: str = Form(...), file: UploadFile = File(...)
):
    body = await file.read()
    key = store_manifest(llama_id, body)
    return {"stored": key, "note": note}


@router.get("/{llama_id}")
async def get_llama(request: Request, llama_id: int):
    # TODO(wreath-port: [translated] get_or_none(**kw) -> await session.fetch_one(Model.select().where(...)) — the contract matches exactly: None on no match, and both raise when more than one row matches [orm.query.get_or_none_exact])
    llama = await Llama.objects.get_or_none(id=llama_id)
    return llama
