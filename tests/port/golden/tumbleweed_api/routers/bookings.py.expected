"""Bookings router — the core transactional surface.

Exercises: ``APIRouter(prefix=, tags=, dependencies=)``, all five method
decorators, ``status_code=``, ``response_model=``, and many ``.objects.``
query calls with ``__`` lookups inside handler bodies (the annotate-only case).
"""
from wreath import Depends, Request, Router

from ..dependencies import get_depends, pagination
from ..messaging import announce_booking
from ..models import Booking, Llama, Ranch
from ..schemas import BookingCreate
from wreath import JSONResponse
from wreath.exceptions import NotFound, UnprocessableEntity

# TODO(wreath-port: [needs-review] router dependencies=<call> is not a literal list; inline the Depends(...) [depends.router_call])
router = Router(prefix="/bookings", tags=["bookings"], dependencies=get_depends())


@router.get("")
async def list_bookings(request: Request, page=Depends(pagination)):
    return (
        # TODO(wreath-port: [translated] filter(**kw) -> Model.select().where(Model.col == value, ...) — every keyword here maps to a wreath predicate with the value unchanged (`__gte` -> >=, `__in` -> .in_()). Run it with session.fetch() for a list, session.count() for a count [orm.query.filter_exact])
        await Booking.objects.filter(status="booked")
        .offset(page["offset"])
        .limit(page["limit"])
        .all()
    )


@router.get("/{booking_id}")
async def get_booking(request: Request, booking_id: str):
    # TODO(wreath-port: [translated] filter(**kw) -> Model.select().where(Model.col == value, ...) — every keyword here maps to a wreath predicate with the value unchanged (`__gte` -> >=, `__in` -> .in_()). Run it with session.fetch() for a list, session.count() for a count [orm.query.filter_exact])
    booking = await Booking.objects.filter(id=booking_id).get_or_none()
    if booking is None:
        raise NotFound("booking not found")
    return booking


@router.post("")
async def create_booking(payload: BookingCreate, request: Request):
    # TODO(wreath-port: [translated] get_or_none(**kw) -> await session.fetch_one(Model.select().where(...)) — the contract matches exactly: None on no match, and both raise when more than one row matches [orm.query.get_or_none_exact])
    llama = await Llama.objects.get_or_none(id=payload.llama_id)
    if llama is None:
        raise UnprocessableEntity("unknown llama")
    # TODO(wreath-port: [needs-review] get(pk) -> await session.get(Model, pk); get(**kw) -> session.fetch_one(...). Left for review even when the arguments are simple, because the *miss* changes: ormar raises NoMatch, wreath returns None, so the caller's error branch has to move [orm.query.get])
    ranch = await Ranch.objects.get(id=llama.ranch.id)
    # TODO(wreath-port: [needs-review] create(**values) -> instance = Model(**values); session.add(instance); await session.flush(). The rewrite is mechanical but the transaction boundary is not: ormar writes immediately, wreath writes when the session flushes, so where the flush goes is yours to choose [orm.query.create])
    booking = await Booking.objects.create(
        ranch=ranch, llama=llama, guests=payload.guests, notes=payload.notes
    )
    await announce_booking(str(booking.id), "booked")
    return JSONResponse({"id": str(booking.id)}, status=201)


# TODO(wreath-port: [translated] status_code=204/304 on a handler with no return -> return Response(status=<int>); wreath coerces a bare `None` return to a 200 JSON `null`, and Response omits content-length for a bodiless status [route.status_code_empty])
@router.delete("/{booking_id}", status_code=204)
async def cancel_booking(request: Request, booking_id: str):
    # TODO(wreath-port: [translated] get_or_none(**kw) -> await session.fetch_one(Model.select().where(...)) — the contract matches exactly: None on no match, and both raise when more than one row matches [orm.query.get_or_none_exact])
    booking = await Booking.objects.get_or_none(id=booking_id)
    if booking is not None:
        await booking.delete()


@router.patch("/{booking_id}")
async def touch_booking(request: Request, booking_id: str, status: str):
    # TODO(wreath-port: [needs-review] filter(**kw) -> Model.select().where(Model.col == value); run it with session.fetch() for a list. This one needs a decision: a `__icontains`/`__startswith` lookup rewrites the *value* (wrap it in wildcards for .ilike()), a `__isnull` has no negated form, a relation lookup (`owner__name`) is a join, and a jsonb lookup needs the container operator by hand [orm.query.filter])
    count = await Booking.objects.filter(
        ranch__slug="high-mesa", id=booking_id
    ).update(status=status)
    return {"updated": count}
