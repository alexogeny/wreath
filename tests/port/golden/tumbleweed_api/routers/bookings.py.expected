"""Bookings router — the core transactional surface.

Exercises: ``APIRouter(prefix=, tags=, dependencies=)``, all five method
decorators, ``status_code=``, ``response_model=``, and many ``.objects.``
query calls with ``__`` lookups inside handler bodies (the annotate-only case).
"""
from wreath import Depends, Request, Router

from ..dependencies import get_depends, pagination
from ..messaging import announce_booking
from ..models import Booking, Llama, Ranch
from ..schemas import BookingCreate
from wreath.exceptions import NotFound, UnprocessableEntity

# TODO(wreath-port: [needs-review] router dependencies=<call> is not a literal list; inline the Depends(...) [depends.router_call])
router = Router(prefix="/bookings", tags=["bookings"], dependencies=get_depends())


@router.get("")
async def list_bookings(request: Request, page=Depends(pagination)):
    return (
        # TODO(wreath-port: [unsupported] ormar .objects. query -> session.fetch(Model.select().where(...)); rewrite by hand (design 07 §6) [orm.query])
        await Booking.objects.filter(status="booked")
        .offset(page["offset"])
        .limit(page["limit"])
        .all()
    )


@router.get("/{booking_id}")
async def get_booking(request: Request, booking_id: str):
    # TODO(wreath-port: [unsupported] ormar .objects. query -> session.fetch(Model.select().where(...)); rewrite by hand (design 07 §6) [orm.query])
    booking = await Booking.objects.filter(id=booking_id).get_or_none()
    if booking is None:
        raise NotFound("booking not found")
    return booking


# TODO(wreath-port: [needs-review] status_code on a multi-statement handler -> wrap the success return in JSONResponse(..., status=) by hand [route.status_code])
@router.post("", status_code=201)
async def create_booking(request: Request, payload: BookingCreate, request: Request):
    # TODO(wreath-port: [unsupported] ormar .objects. query -> session.fetch(Model.select().where(...)); rewrite by hand (design 07 §6) [orm.query])
    llama = await Llama.objects.get_or_none(id=payload.llama_id)
    if llama is None:
        raise UnprocessableEntity("unknown llama")
    # TODO(wreath-port: [unsupported] ormar .objects. query -> session.fetch(Model.select().where(...)); rewrite by hand (design 07 §6) [orm.query])
    ranch = await Ranch.objects.get(id=llama.ranch.id)
    # TODO(wreath-port: [unsupported] ormar .objects. query -> session.fetch(Model.select().where(...)); rewrite by hand (design 07 §6) [orm.query])
    booking = await Booking.objects.create(
        ranch=ranch, llama=llama, guests=payload.guests, notes=payload.notes
    )
    await announce_booking(str(booking.id), "booked")
    return {"id": str(booking.id)}


# TODO(wreath-port: [needs-review] status_code on a multi-statement handler -> wrap the success return in JSONResponse(..., status=) by hand [route.status_code])
@router.delete("/{booking_id}", status_code=204)
async def cancel_booking(request: Request, booking_id: str):
    # TODO(wreath-port: [unsupported] ormar .objects. query -> session.fetch(Model.select().where(...)); rewrite by hand (design 07 §6) [orm.query])
    booking = await Booking.objects.get_or_none(id=booking_id)
    if booking is not None:
        await booking.delete()


@router.patch("/{booking_id}")
async def touch_booking(request: Request, booking_id: str, status: str):
    # TODO(wreath-port: [unsupported] ormar .objects. query -> session.fetch(Model.select().where(...)); rewrite by hand (design 07 §6) [orm.query])
    count = await Booking.objects.filter(
        ranch__slug="high-mesa", id=booking_id
    ).update(status=status)
    return {"updated": count}
