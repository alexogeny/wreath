"""Bookings router — the core transactional surface.

Exercises: ``APIRouter(prefix=, tags=, dependencies=)``, all five method
decorators, ``status_code=``, ``response_model=``, and many ``.objects.``
query calls with ``__`` lookups inside handler bodies (the annotate-only case).
"""
from wreath import Depends, Request, Router

from ..dependencies import get_depends, pagination
from ..messaging import announce_booking
from ..models import Booking, Llama, Ranch
from ..schemas import BookingCreate
from wreath import JSONResponse
from wreath.exceptions import NotFound, UnprocessableEntity
from wreath.orm import FromORM, Session
from typing import Annotated

# TODO(wreath-port: [needs-review] The router's dependencies= is a call rather than a plain list, so this tool cannot see what is in it. Write the Depends(...) entries out as a list. [depends.router_call])
router = Router(prefix="/bookings", tags=["bookings"], dependencies=get_depends())


@router.get("")
async def list_bookings(request: Request, *, session: Annotated[Session, FromORM()], page=Depends(pagination)):
    return (
        await session.fetch(Booking.select().where(Booking.status == "booked").limit(page["limit"]).offset(page["offset"]))
    )


@router.get("/{booking_id}")
async def get_booking(request: Request, *, session: Annotated[Session, FromORM()], booking_id: str):
    booking = await session.fetch_one(Booking.select().where(Booking.id == booking_id))
    if booking is None:
        raise NotFound("booking not found")
    return booking


@router.post("")
async def create_booking(payload: BookingCreate, request: Request, *, session: Annotated[Session, FromORM()]):
    llama = await session.fetch_one(Llama.select().where(Llama.id == payload.llama_id))
    if llama is None:
        raise UnprocessableEntity("unknown llama")
    ranch = await session.require(Ranch, llama.ranch.id)
    booking = await session.create(Booking, ranch=ranch, llama=llama, guests=payload.guests, notes=payload.notes)
    await announce_booking(str(booking.id), "booked")
    return JSONResponse({"id": str(booking.id)}, status=201)


# TODO(wreath-port: [translated] Return Response(status=<number>). A handler that returns nothing would otherwise answer 200 with a JSON null, and Response leaves out content-length for a status that carries no body. [route.status_code_empty])
@router.delete("/{booking_id}", status_code=204)
async def cancel_booking(request: Request, *, session: Annotated[Session, FromORM()], booking_id: str):
    booking = await session.fetch_one(Booking.select().where(Booking.id == booking_id))
    if booking is not None:
        await booking.delete()


@router.patch("/{booking_id}")
async def touch_booking(request: Request, booking_id: str, status: str):
    # TODO(wreath-port: [needs-review] This filter was left as written because one of its lookups needs a decision. A lookup across a relation (owner__name) becomes Model.owner.name -- wreath adds the join itself, but it has to be told which model owner points at, and that model is usually in another file. A JSON lookup needs you to pick the containment operator. Everything else about the query is mechanical: Model.select().where(...), run with session.fetch(). [orm.query.filter])
    count = await Booking.objects.filter(
        ranch__slug="high-mesa", id=booking_id
    ).update(status=status)
    return {"updated": count}
