"""Gear-intake routes — a handler that consumes the ``as_form`` model, a single-return
``status_code`` handler, and a ``response_model`` handler (all now translated)."""
from __future__ import annotations

from wreath import Depends, Router

from .forms import GearManifestForm
from wreath import JSONResponse, Request
from wreath.binding import Form
from typing import Annotated

router = Router(prefix="/intake", tags=["intake"])


@router.post("")
async def submit(request: Request, manifest: Annotated[GearManifestForm, Form()]):
    return JSONResponse(manifest, status=201)


@router.get("/{expedition_id}")
async def latest(request: Request, expedition_id: str):
    return GearManifestForm(expedition_id=expedition_id)
