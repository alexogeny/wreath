"""Gear-intake routes — a handler that consumes the ``as_form`` model, a
``status_code`` handler that returns a DTO, and a ``response_model`` handler.

The middle one is the ``status_code`` case that must NOT be auto-wrapped: the
return is a model instance, and ``JSONResponse(<dataclass>)`` raises in wreath.
"""
from __future__ import annotations

from wreath import Depends, Router

from .forms import GearManifestForm
from wreath import Request
from wreath.binding import Form
from typing import Annotated

router = Router(prefix="/intake", tags=["intake"])


# TODO(wreath-port: [needs-review] Wreath puts the status on the response the handler returns, not on the route. This handler's return value could be anything, so pick the wrapper that matches it: JSONResponse for a dict, list or number, TextResponse for a string, and dataclasses.asdict first if it returns a dataclass. [route.status_code])
@router.post("", status_code=201)
async def submit(request: Request, manifest: Annotated[GearManifestForm, Form()]):
    return manifest


@router.get("/{expedition_id}")
async def latest(request: Request, expedition_id: str):
    return GearManifestForm(expedition_id=expedition_id)
