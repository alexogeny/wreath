# No active suppressions. Every reported leak must be investigated and fixed.
#
# Known non-leak: importing neo.orm with the native extension leaves a fixed
# residue of roughly 240 allocations at interpreter shutdown, in stacks that are
# entirely inside libpython. It is CPython's, not ours: it reproduces with a
# bare `class Meta(_ModelType): def __new__(...)` and disappears when the
# metaclass derives from `type` instead, with or without our metatype dealloc.
# neo.orm needs that metaclass so a model class can be created by Python while
# its storage base is generated in C (see src/neo/_native/postgres/model.c).
#
# It is deliberately NOT suppressed: every frame is libpython, so any pattern
# broad enough to hide it would hide real leaks too.
#
# The residue is constant, which is what distinguishes it from a real leak. To
# check the model storage for leaks, compare allocation counts across load
# levels rather than reading the absolute number -- a real leak grows:
#
#   for n in 1 50 200; do
#     ASAN_OPTIONS=detect_leaks=1 LD_PRELOAD=$(gcc -print-file-name=libasan.so) \
#     PYTHONPATH=.sanitizers/native-postgres/lib .venv/bin/python -c "
#   import gc
#   from neo.orm import Mapped, Model, column
#   from neo.orm.types import Int64, Text
#   for i in range($n):
#       class M(Model, table='m%d' % i):
#           id: Mapped[int] = column(Int64, primary_key=True)
#           label: Mapped[str] = column(Text)
#       xs = [M(id=j, label='x'*j) for j in range(50)]
#       del xs, M
#   gc.collect()
#   " 2>&1 | grep -oE '[0-9]+ allocation'
#   done
#
# As of the native model storage landing, that reports ~240 allocations at every
# level. Run the suites with ASAN_OPTIONS=detect_leaks=0 to surface memory
# errors and UB without this noise; pytest itself leaks megabytes under LSan.
